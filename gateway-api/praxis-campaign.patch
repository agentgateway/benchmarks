diff --git a/tests/campaign.py b/tests/campaign.py
new file mode 100755
index 0000000..d97942a
--- /dev/null
+++ b/tests/campaign.py
@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""Run existing Gateway API benchmarks with bounded runtimes and raw evidence."""
+
+import argparse
+import datetime
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import shutil
+import subprocess
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def utc_now():
+    return datetime.datetime.now(datetime.timezone.utc).isoformat()
+
+
+def cases(profile):
+    routes = "25" if profile == "smoke" else "1000"
+    iterations = "25" if profile == "smoke" else "1000"
+    traffic_duration = "10" if profile == "smoke" else "60"
+    yield "attached-routes", ["bash", "tests/attached-routes.sh", "split", f"--routes={routes}"], 600, False
+    yield "probe", ["bash", "tests/probe.sh", f"--routes={routes}"], 900, False
+    yield "routechange", ["bash", "tests/routechange.sh", f"--iterations={iterations}"], 900, False
+    scales = [(1, 25)] if profile == "smoke" else [(10, 100), (50, 100)]
+    for namespaces, count in scales:
+        yield f"scale-{namespaces}x{count}", ["bash", "tests/route-load.sh", str(namespaces), str(count)], 60 if profile == "smoke" else 600, True
+    connections = [1, 16] if profile == "smoke" else [1, 16, 512]
+    for connections_count in connections:
+        for qps in ([1000] if profile == "smoke" else [0, 10000]):
+            yield f"traffic-c{connections_count}-q{qps}", ["bash", "tests/traffic.sh", "-d", traffic_duration, "-q", str(qps), "-c", str(connections_count), "-p", "0"], 300, False
+
+
+def execute(command, log_path, env, timeout, timed_load=False):
+    started = utc_now()
+    start = time.monotonic()
+    timed_out = False
+    with log_path.open("w") as output:
+        process = subprocess.Popen(command, cwd=ROOT, env=env, stdout=output,
+                                   stderr=subprocess.STDOUT, start_new_session=True)
+        try:
+            code = process.wait(timeout=timeout)
+        except subprocess.TimeoutExpired:
+            timed_out = True
+            # Let pilot-load delete its generated resources before escalation.
+            os.killpg(process.pid, signal.SIGINT)
+            try:
+                code = process.wait(timeout=30)
+            except subprocess.TimeoutExpired:
+                os.killpg(process.pid, signal.SIGKILL)
+                code = process.wait()
+                timed_load = False  # Forced termination may leave cluster state.
+    if timed_out:
+        outcome = "duration_complete" if timed_load and code in (0, 130, -signal.SIGINT) else "timeout"
+    else:
+        outcome = "completed" if code == 0 and not timed_load else "failed"
+    return {"command": command, "started_at": started, "elapsed_seconds": time.monotonic() - start,
+            "exit_code": code, "outcome": outcome, "log": str(log_path)}
+
+
+def snapshot(destination):
+    commands = {
+        "suite-revision.txt": ["git", "rev-parse", "HEAD"],
+        "suite-diff.patch": ["git", "diff"],
+        "client-version.json": ["kubectl", "version", "-o", "json"],
+        "nodes.json": ["kubectl", "get", "nodes", "-o", "json"],
+        "pods.json": ["kubectl", "get", "pods", "-A", "-o", "json"],
+        "deployments.json": ["kubectl", "get", "deployments", "-A", "-o", "json"],
+        "gateways.json": ["kubectl", "get", "gateway", "-A", "-o", "json"],
+        "gatewayclasses.json": ["kubectl", "get", "gatewayclass", "-o", "json"],
+        "routes.json": ["kubectl", "get", "httproute", "-A", "-o", "json"],
+    }
+    destination.mkdir(parents=True)
+    failures = []
+    for name, command in commands.items():
+        result = execute(command, destination / name, os.environ.copy(), 30)
+        if result["outcome"] != "completed":
+            failures.append(result)
+    (destination / "capture-errors.json").write_text(json.dumps(failures, indent=2) + "\n")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--gateways", default="agentgateway/agentgateway,praxis/praxis")
+    parser.add_argument("--profile", choices=["smoke", "full"], default="smoke")
+    parser.add_argument("--repetitions", type=int, default=3)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--case", action="append", default=[], help="Run only named cases; repeat to select several")
+    parser.add_argument("--dry-run", action="store_true")
+    args = parser.parse_args()
+    gateways = args.gateways.split(",")
+    if args.repetitions < 1 or any(not re.fullmatch(r"[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*", value) for value in gateways):
+        parser.error("Use positive repetitions and comma-separated namespace/name gateways")
+    selected = [case for case in cases(args.profile) if not args.case or case[0] in args.case]
+    unknown = set(args.case) - {case[0] for case in selected}
+    if unknown:
+        parser.error(f"Unknown cases: {sorted(unknown)}")
+    plan = []
+    for repetition in range(args.repetitions):
+        # Counterbalance order; never run both implementations' load concurrently.
+        order = gateways if repetition % 2 == 0 else list(reversed(gateways))
+        for name, command, timeout, timed_load in selected:
+            for gateway in order:
+                plan.append({"repetition": repetition + 1, "gateway": gateway, "case": name,
+                             "command": command, "timeout_seconds": timeout, "timed_load": timed_load})
+    if args.dry_run:
+        print(json.dumps(plan, indent=2))
+        return 0
+    dependencies = ["bash", "git", "kubectl", "go"]
+    if any(item[0].startswith("traffic-") for item in selected):
+        dependencies.append("docker")
+    if any(item[0].startswith("scale-") for item in selected):
+        dependencies.append("pilot-load")
+    missing = [command for command in dependencies if not shutil.which(command)]
+    if missing:
+        parser.error(f"Missing tools: {', '.join(missing)}")
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    (output / "plan.json").write_text(json.dumps(plan, indent=2) + "\n")
+    snapshot(output / "before")
+    results = []
+    for item in plan:
+        name = f"r{item['repetition']}-{item['gateway'].replace('/', '-')}-{item['case']}"
+        print(f"{utc_now()} {name}", flush=True)
+        env = dict(os.environ, GATEWAYS=item["gateway"], RESULTS_DIR=str(output / name))
+        result = execute(item["command"], output / f"{name}.log", env,
+                         item["timeout_seconds"], item["timed_load"])
+        results.append(dict(item, **result))
+        (output / "results.json").write_text(json.dumps(results, indent=2) + "\n")
+        snapshot(output / f"{name}-state")
+        if result["outcome"] == "timeout":
+            # An incompletely cleaned load test could contaminate later cases.
+            break
+    snapshot(output / "after")
+    return int(any(result["outcome"] not in ("completed", "duration_complete") for result in results))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
