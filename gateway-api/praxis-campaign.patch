+#!/usr/bin/env bash
+set -euo pipefail
+
+WD=$(cd "$(dirname "$0")" && pwd)
+operator_revision="${PRAXIS_OPERATOR_REVISION:-fb8beaa14cf714dacf0e6964cc8be94d1b5c1d7c}"
+: "${PRAXIS_OPERATOR_IMAGE:?Set the image built from PRAXIS_OPERATOR_REVISION, preferably by digest}"
+: "${PRAXIS_IMAGE:?Set a pinned Praxis data-plane image, preferably by digest}"
+
+# The operator currently has no published release. Use its exact source manifests
+# with explicitly supplied image references; do not silently select latest.
+if [[ ! "$operator_revision" =~ ^[a-f0-9]{40}$ ]]; then
+  echo "PRAXIS_OPERATOR_REVISION must be a full commit SHA" >&2
+  exit 1
+fi
+manifest_dir=$(mktemp -d)
+trap 'rm -rf "$manifest_dir"' EXIT
+for manifest in rbac deployment gatewayclass; do
+  curl --fail --silent --show-error --location \
+    "https://raw.githubusercontent.com/praxis-proxy/operator/${operator_revision}/deploy/${manifest}.yaml" \
+    > "$manifest_dir/$manifest.yaml"
+done
+python3 - "$manifest_dir/deployment.yaml" <<'PY'
+import os
+import pathlib
+import sys
+
+path = pathlib.Path(sys.argv[1])
+text = path.read_text()
+for name in ("OPERATOR_IMAGE", "PRAXIS_IMAGE"):
+    value = os.environ["PRAXIS_OPERATOR_IMAGE" if name == "OPERATOR_IMAGE" else name]
+    if not value or any(c.isspace() or c in "\"'\\" for c in value):
+        raise SystemExit(f"Invalid image reference: {name}")
+    text = text.replace(f"__{name}__", value)
+path.write_text(text)
+PY
+kubectl apply --server-side -f "$manifest_dir/rbac.yaml"
+kubectl apply --server-side -f "$manifest_dir/deployment.yaml"
+kubectl apply --server-side -f "$manifest_dir/gatewayclass.yaml"
+kubectl rollout status -n praxis-system deployment/praxis-operator --timeout=180s
+kubectl apply --server-side -f "$WD/praxis.yaml"
+kubectl wait -n praxis gateway/praxis --for=condition=Programmed --timeout=300s
