+#!/usr/bin/env bash
+set -euo pipefail
+
+WD=$(cd "$(dirname "$0")" && pwd)
+version="${AGENTGATEWAY_VERSION:-v1.5.0}"
+
+# Preserve basic.sh's historical kgateway setup. This is the current independent
+# agentgateway controller; any additional arguments are controller Helm values.
+helm upgrade --install agentgateway-crds oci://cr.agentgateway.dev/charts/agentgateway-crds \
+  --version "$version" --namespace agentgateway-system --create-namespace --wait
+helm upgrade --install agentgateway oci://cr.agentgateway.dev/charts/agentgateway \
+  --version "$version" --namespace agentgateway-system --wait "$@"
+kubectl apply --server-side -f "$WD/agentgateway-current.yaml"
+kubectl wait -n agentgateway gateway/agentgateway --for=condition=Programmed --timeout=300s
