From 25d513948a41463199fadded4828315527736e15 Mon Sep 17 00:00:00 2001
From: Daneyon Hansen <daneyon.hansen@solo.io>
Date: Thu, 1 Oct 2026 19:41:20 -0700
Subject: [PATCH 2/2] Validate readiness and raw traffic measurements

Signed-off-by: Daneyon Hansen <daneyon.hansen@solo.io>
---
 tests/traffic.sh | 36 +++++++++++++++++++++++++++++++++++-
 1 file changed, 35 insertions(+), 1 deletion(-)

diff --git a/tests/traffic.sh b/tests/traffic.sh
index e98aeb5..ccf79b9 100755
--- a/tests/traffic.sh
+++ b/tests/traffic.sh
@@ -48,7 +48,7 @@ targets=()
 for gw in "${gateways[@]}"; do
   name="$(<<<"$gw" cut -d/ -f 2)"
   namespace="$(<<<"$gw" cut -d/ -f 1)"
-  targets+=("$(gw-address $gw)#$name")
+  targets+=("$(gw-address "$gw")#$name")
   cat <<EOF | kubectl apply -f - --server-side=true
 apiVersion: gateway.networking.k8s.io/v1
 kind: HTTPRoute
@@ -66,6 +66,23 @@ spec:
 EOF
 done
 
+# HTTPRoute acceptance and data-plane readiness are asynchronous. Exclude
+# convergence from steady-state measurements, but retain the wait in the log.
+for target in "${targets[@]}"; do
+  address="${target%%#*}"
+  ready=false
+  for attempt in $(seq 1 120); do
+    code=$(curl --max-time 2 -s -o /dev/null -w '%{http_code}' "http://$address/" || true)
+    if [[ "$code" == 200 ]]; then ready=true; break; fi
+    sleep 1
+  done
+  if [[ "$ready" != true ]]; then
+    echo "Readiness failed for $target: HTTP $code" >&2
+    exit 1
+  fi
+  echo "Ready: $target after $attempt probe(s) at $(date -u +%FT%TZ)"
+done
+
 results_dir="${RESULTS_DIR:-/tmp/results}"
 mkdir -p "$results_dir"
 docker_tty=()
@@ -74,3 +91,20 @@ if [[ -t 0 && -t 1 ]]; then
 fi
 docker run --rm -v "$results_dir:/tmp/results" --init "${docker_tty[@]}" --network=host \
   "${BENCHTOOL_IMAGE:-howardjohn/benchtool}" "$@" "$(join_by , "${targets[@]}")"
+
+# The upstream benchtool wrapper may exit zero after Fortio aborts. A campaign
+# invocation has one target; validate that its raw result actually exists.
+python3 - "$results_dir/fortio.json" <<'PYTHON'
+import json
+from pathlib import Path
+import sys
+p = Path(sys.argv[1])
+if not p.is_file():
+    raise SystemExit("Missing Fortio result: traffic measurement failed")
+r = json.loads(p.read_text())
+counts = r.get("RetCodes", {})
+if r.get("ActualDuration", 0) <= 0 or sum(counts.values()) <= 0:
+    raise SystemExit("Empty Fortio measurement")
+if any(count for code, count in counts.items() if code != "200"):
+    raise SystemExit("Fortio recorded failed requests; preserve raw evidence")
+PYTHON
-- 
